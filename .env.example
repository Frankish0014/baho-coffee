############################################
# Baho Coffee - Example Environment Config #
############################################

########################
# Core App Settings
########################

# Public site URL (used in emails, links)
NEXT_PUBLIC_SITE_URL=https://bahocoffee.com

########################
# Email (Resend)
########################

# Required: Resend API key (from https://resend.com)
RESEND_API_KEY=re_your_resend_api_key_here

# Sender used for most transactional emails
# Recommended: verified domain address
RESEND_FROM_EMAIL=noreply@bahocoffee.com

# Admin / notifications email (order alerts, contact copies, etc.)
ADMIN_EMAIL=info@bahocoffee.com

########################
# Stripe Payments
########################

# Secret key (Test or Live)
STRIPE_SECRET_KEY=sk_test_your_test_secret_key_here

# Publishable key for frontend
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your_test_publishable_key_here

# Webhook signing secret from Stripe dashboard
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_here

########################
# Database (Postgres)
########################

# Primary Postgres connection (Vercel Postgres or other)
POSTGRES_URL=postgres://user:password@host:5432/dbname

# Optional: Prisma / non-pooling URLs if you use them
POSTGRES_PRISMA_URL=postgres://user:password@host:5432/dbname
POSTGRES_URL_NON_POOLING=postgres://user:password@host:5432/dbname

# Optional local Postgres for development
LOCAL_POSTGRES_URL=postgres://user:password@localhost:5432/bahocoffee
DATABASE_URL=postgres://user:password@localhost:5432/bahocoffee

########################
# Sanity (CMS)
########################

NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2025-11-23

########################
# Google Analytics
########################

# GA4 Measurement ID (e.g. G-XXXXXXXXXX)
NEXT_PUBLIC_GA_ID=

########################
# Maps & Instagram (optional)
########################

# If you switch to Google Maps instead of OpenStreetMap
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# For Instagram feed component (if enabled)
NEXT_PUBLIC_INSTAGRAM_ACCESS_TOKEN=

########################
# Bank Transfer Details
########################

BANK_ACCOUNT_NAME=Baho Coffee Ltd
BANK_NAME=Bank of Kigali
BANK_ACCOUNT_NUMBER=0000 1234 5678 90
BANK_IBAN=RW12 3456 7890
BANK_SWIFT_CODE=BKIGRWRW
BANK_ADDRESS=KN 4 Ave, Kigali, Rwanda

# Contact details shown in bank instructions / payment emails
BANK_CONTACT_EMAIL=info@bahocoffee.com
BANK_CONTACT_PHONE=+250 788 302 976

# Currency and payment deadline (in hours) for bank transfers
BANK_CURRENCY=USD
BANK_PAYMENT_DEADLINE_HOURS=48

# Optional: custom bank instructions, separated by |
# Example:
# NEXT_PUBLIC_BANK_INSTRUCTIONS=Include your Order ID in the reference.|Send proof of payment to info@bahocoffee.com or WhatsApp +250 788 302 976.
NEXT_PUBLIC_BANK_INSTRUCTIONS=

########################
# AI / External APIs (optional)
########################

# OpenAI (used by /api/ai/chat if configured)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Serper (Google-like search for AI tools)
SERPER_API_KEY=

# Anthropic (if you ever wire it via AI_SETUP.md)
ANTHROPIC_API_KEY=

########################
# Feature Flags (optional)
########################

# Protect backend API routes with a shared secret (proxy.ts)
ENABLE_API_AUTH=false

